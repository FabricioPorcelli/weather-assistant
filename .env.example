WEATHER_API_BASE_URL=http://localhost:8000
WEATHER_API_TIMEOUT_SECONDS=10
# Reintentos para 502, 504 y timeouts.
WEATHER_API_RETRIES=1
# Espera entre reintentos, en segundos.
WEATHER_API_RETRY_DELAY_SECONDS=0.5
# Orígenes CORS separados por coma.
ASSISTANT_CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

DATABASE_URL=postgresql+asyncpg://assistant:assistant@localhost:5432/assistant
REDIS_URL=redis://localhost:6379/1
# Formato de limits: cantidad/período.
RATE_LIMIT=20/minute
MAX_MESSAGE_CHARS=500
# Pares usuario/asistente enviados al LLM.
HISTORY_TURNS=6

LLM_BASE_URL=https://api.groq.com/openai/v1
# Clave del proveedor. No se versiona.
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=30
MAX_TOOL_CALLS_PER_TURN=4

# OpenCode: usar la misma LLM_API_KEY con estos valores.
# LLM_BASE_URL=https://opencode.ai/inference/openai/v1
# LLM_MODEL=deepseek-v4.1-flash
