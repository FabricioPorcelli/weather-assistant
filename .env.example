# Copiar este archivo a .env y ajustar si hace falta.
# El archivo .env NUNCA se versiona (está en .gitignore).

WEATHER_API_BASE_URL=http://localhost:8000
WEATHER_API_TIMEOUT_SECONDS=10
# Reintento único para 502/504 y timeouts transitorios de weather-api.
WEATHER_API_RETRIES=1
WEATHER_API_RETRY_DELAY_SECONDS=0.5
ASSISTANT_CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- LLM: configuración actual con Groq ---
# Completar LLM_API_KEY con la clave de Groq.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=30
MAX_TOOL_CALLS_PER_TURN=4

# --- Alternativa: OpenCode ---
# Si querés usar la API de OpenCode en lugar de Groq, cambiá estas variables:
# LLM_BASE_URL=https://opencode.ai/inference/openai/v1
# LLM_MODEL=deepseek-v4.1-flash
# LLM_API_KEY=tu_clave_oficial_de_opencode
# Verificá que tu cuenta permita usar el modelo desde clientes externos.
